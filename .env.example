# Bu dosyayı `.env.local` olarak kopyalayıp gerçek değerlerle doldur.
# `.env.local` Git'e girmez (.gitignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<proje>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# /admin (Editör Masası) için ZORUNLU: kullanıcı listesi ve tüm katkıları
# RLS'i aşarak okur. Bu olmadan /admin sunucu hatası verir.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # GİZLİ, yalnızca sunucu (NEXT_PUBLIC_ KULLANMA)

# --- Spotify ---
SPOTIFY_CLIENT_ID=<client-id>
SPOTIFY_CLIENT_SECRET=<client-secret>          # GİZLİ

# --- YouTube (video eşleştirme ve gömülü önizleme) ---
# Google Cloud Console'da YouTube Data API v3'ü açıp sunucu anahtarı oluştur.
YOUTUBE_API_KEY=<youtube-data-api-key>         # GİZLİ, NEXT_PUBLIC_ kullanma

# --- İletişim formu / Resend ---
RESEND_API_KEY=<resend-api-key>                # GİZLİ
ILETISIM_ALICI_EMAIL=iletisim@anadoluturkuleri.com
# Gönderen adresi Resend'de doğrulanmış alan adını kullanmalı.
ILETISIM_GONDEREN_EMAIL=Anadolu Türküleri <bildirim@mail.anadoluturkuleri.com>

# --- Opsiyonel ---
# 1 = sitede yalnızca "dogrulandi" türküler görünür
NEXT_PUBLIC_SADECE_DOGRULANMIS=0

# --- Opsiyonel anonim ürün analitiği (PostHog EU) ---
# Boş bırakıldığında analitik ve izin bildirimi tamamen devre dışıdır.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
