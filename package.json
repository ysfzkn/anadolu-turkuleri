    "verify:deploy": "npm run typecheck && npm run check:deploy && npm run build",
    "ingest": "tsx scripts/ingest.ts",
    "review": "tsx scripts/review.ts",
    "validate": "tsx scripts/validate.ts",
    "sync:city-images": "tsx scripts/sync-city-images.ts",
    "sync:wikisource": "tsx scripts/sync-wikisource-catalog.ts",
    "enrich:wikisource": "tsx scripts/enrich-wikisource.ts",
    "sync:sivas": "tsx scripts/sync-sivas.ts",
    "sync:all-cities": "tsx scripts/sync-all-cities.ts",
