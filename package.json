    "@types/node": "20.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.170.0",
    "autoprefixer": "10.4.19",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.6",
    "tsx": "^4.23.12",
    "typescript": "5.5.3"
