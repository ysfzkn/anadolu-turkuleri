  "private": true,
  "description": "Anadolu türkülerini hikâyeleri, yöreleri, ozanları ve notalarıyla buluşturan dijital arşiv.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
