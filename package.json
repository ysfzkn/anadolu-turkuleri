  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "html-to-image": "1.11.11",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
